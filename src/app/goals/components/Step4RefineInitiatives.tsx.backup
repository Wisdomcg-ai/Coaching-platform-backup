'use client'

import { StrategicInitiative, InitiativeCategory, InitiativePriority, InitiativeEffort } from '../types'
import { AlertCircle, X, Check, GripVertical, ChevronDown, ChevronUp, Filter, Zap } from 'lucide-react'
import { useState, useMemo } from 'react'

interface Step4Props {
  strategicIdeas: StrategicInitiative[]
  roadmapSuggestions: StrategicInitiative[]
  twelveMonthInitiatives: StrategicInitiative[]
  setTwelveMonthInitiatives: (initiatives: StrategicInitiative[]) => void
}

const CATEGORY_INFO: Record<InitiativeCategory, { label: string; emoji: string }> = {
  'marketing': { label: 'Marketing & Sales', emoji: '📢' },
  'operations': { label: 'Operations', emoji: '⚙️' },
  'finance': { label: 'Finance', emoji: '💰' },
  'people': { label: 'People & Culture', emoji: '👥' },
  'systems': { label: 'Systems & Tech', emoji: '💻' },
  'product': { label: 'Product & Service', emoji: '🎯' },
  'customer_experience': { label: 'Customer Experience', emoji: '⭐' },
  'other': { label: 'Other', emoji: '📋' }
}

const PRIORITY_INFO: Record<InitiativePriority, { label: string; color: string }> = {
  'high': { label: 'HIGH', color: 'bg-orange-100 text-orange-700' },
  'medium': { label: 'MED', color: 'bg-blue-100 text-blue-700' },
  'low': { label: 'LOW', color: 'bg-slate-100 text-slate-600' }
}

const EFFORT_INFO: Record<InitiativeEffort, { label: string; icon: string }> = {
  'small': { label: 'Quick Win', icon: '⚡' },
  'medium': { label: 'Medium Effort', icon: '⏱️' },
  'large': { label: 'Large Effort', icon: '🎯' }
}

export default function Step4RefineInitiatives({
  strategicIdeas,
  roadmapSuggestions,
  twelveMonthInitiatives,
  setTwelveMonthInitiatives
}: Step4Props) {
  const [filterCategory, setFilterCategory] = useState<InitiativeCategory | 'all'>('all')
  const [filterPriority, setFilterPriority] = useState<InitiativePriority | 'all'>('all')
  const [searchQuery, setSearchQuery] = useState('')
  const [expandedId, setExpandedId] = useState<string | null>(null)
  const [draggedIndex, setDraggedIndex] = useState<number | null>(null)
  const [showFilters, setShowFilters] = useState(false)
  const [showBalanceDetails, setShowBalanceDetails] = useState(false)

  // Combine all available initiatives
  const allAvailableInitiatives = [...strategicIdeas, ...roadmapSuggestions]

  const selectedCount = twelveMonthInitiatives.length
  const isOverLimit = selectedCount > 10
  const isInRange = selectedCount >= 5 && selectedCount <= 10

  // Filter available initiatives
  const filteredInitiatives = useMemo(() => {
    let filtered = allAvailableInitiatives

    // Search filter
    if (searchQuery.trim()) {
      const query = searchQuery.toLowerCase()
      filtered = filtered.filter(
        init =>
          init.title.toLowerCase().includes(query) ||
          init.description?.toLowerCase().includes(query) ||
          init.notes?.toLowerCase().includes(query)
      )
    }

    // Category filter
    if (filterCategory !== 'all') {
      filtered = filtered.filter(init => init.category === filterCategory)
    }

    // Priority filter
    if (filterPriority !== 'all') {
      filtered = filtered.filter(init => init.priority === filterPriority)
    }

    return filtered
  }, [allAvailableInitiatives, searchQuery, filterCategory, filterPriority])

  // Calculate balance stats
  const balanceStats = useMemo(() => {
    const categoryCount: Partial<Record<InitiativeCategory, number>> = {}
    const effortCount: Partial<Record<InitiativeEffort, number>> = {}
    let fromIdeas = 0
    let fromRoadmap = 0

    twelveMonthInitiatives.forEach(init => {
      if (init.category) {
        categoryCount[init.category] = (categoryCount[init.category] || 0) + 1
      }
      if (init.estimatedEffort) {
        effortCount[init.estimatedEffort] = (effortCount[init.estimatedEffort] || 0) + 1
      }
      if (init.source === 'strategic_ideas' || strategicIdeas.some(i => i.id === init.id)) {
        fromIdeas++
      } else {
        fromRoadmap++
      }
    })

    const categoryDiversity = Object.keys(categoryCount).length
    const quickWins = effortCount['small'] || 0

    return {
      categoryCount,
      effortCount,
      fromIdeas,
      fromRoadmap,
      categoryDiversity,
      quickWins
    }
  }, [twelveMonthInitiatives, strategicIdeas])

  // Toggle initiative selection
  const handleToggleInitiative = (initiative: StrategicInitiative) => {
    const isSelected = twelveMonthInitiatives.some(item => item.id === initiative.id)

    if (isSelected) {
      setTwelveMonthInitiatives(
        twelveMonthInitiatives.filter(item => item.id !== initiative.id)
      )
    } else {
      setTwelveMonthInitiatives([
        ...twelveMonthInitiatives,
        { ...initiative, selected: true, order: twelveMonthInitiatives.length }
      ])
    }
  }

  // Remove initiative from selected
  const handleRemoveInitiative = (initiativeId: string) => {
    setTwelveMonthInitiatives(
      twelveMonthInitiatives.filter(item => item.id !== initiativeId)
    )
  }

  // Clear all selections
  const handleClearAll = () => {
    setTwelveMonthInitiatives([])
  }

  // Batch actions
  const handleSelectAllHighPriority = () => {
    const highPriorityItems = allAvailableInitiatives.filter(
      init => init.priority === 'high' && !twelveMonthInitiatives.some(selected => selected.id === init.id)
    )
    setTwelveMonthInitiatives([
      ...twelveMonthInitiatives,
      ...highPriorityItems.map((init, idx) => ({
        ...init,
        selected: true,
        order: twelveMonthInitiatives.length + idx
      }))
    ])
  }

  const handleSelectAllRecommended = () => {
    const recommendedItems = roadmapSuggestions.filter(
      init => !twelveMonthInitiatives.some(selected => selected.id === init.id)
    )
    setTwelveMonthInitiatives([
      ...twelveMonthInitiatives,
      ...recommendedItems.map((init, idx) => ({
        ...init,
        selected: true,
        order: twelveMonthInitiatives.length + idx
      }))
    ])
  }

  // Drag and drop handlers
  const handleDragStart = (index: number) => {
    setDraggedIndex(index)
  }

  const handleDragOver = (e: React.DragEvent, index: number) => {
    e.preventDefault()

    if (draggedIndex === null || draggedIndex === index) return

    const reordered = [...twelveMonthInitiatives]
    const draggedItem = reordered[draggedIndex]
    reordered.splice(draggedIndex, 1)
    reordered.splice(index, 0, draggedItem)

    // Update order property
    const updated = reordered.map((init, idx) => ({ ...init, order: idx }))

    setTwelveMonthInitiatives(updated)
    setDraggedIndex(index)
  }

  const handleDragEnd = () => {
    setDraggedIndex(null)
  }

  const hasFilters = searchQuery || filterCategory !== 'all' || filterPriority !== 'all'

  return (
    <div className="space-y-4">
      {/* Simplified Header - Just Selection Status */}
      <div className="bg-white rounded-lg shadow-sm p-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-4">
            <div>
              <p className="text-sm font-medium text-slate-900">
                Selected: <span className={selectedCount === 0 ? 'text-slate-500' : 'font-bold text-blue-600'}>{selectedCount}</span> of 5-10 initiatives
              </p>
            </div>
            {isInRange && (
              <div className="flex items-center gap-1 text-sm text-emerald-600 font-medium">
                <Check className="w-4 h-4" /> Perfect range
              </div>
            )}
            {isOverLimit && (
              <div className="flex items-center gap-1 text-sm text-amber-600 font-medium">
                <AlertCircle className="w-4 h-4" /> Remove {selectedCount - 10}
              </div>
            )}
            {selectedCount > 0 && selectedCount < 5 && (
              <div className="flex items-center gap-1 text-sm text-slate-600">
                Add {5 - selectedCount} more
              </div>
            )}
          </div>

          {/* Batch Actions */}
          {allAvailableInitiatives.length > 0 && (
            <div className="flex items-center gap-2">
              {allAvailableInitiatives.filter(i => i.priority === 'high').length > 0 && (
                <button
                  onClick={handleSelectAllHighPriority}
                  className="text-xs px-3 py-1.5 bg-orange-50 text-orange-700 rounded hover:bg-orange-100 font-medium"
                >
                  + All High Priority
                </button>
              )}
              {roadmapSuggestions.length > 0 && (
                <button
                  onClick={handleSelectAllRecommended}
                  className="text-xs px-3 py-1.5 bg-blue-50 text-blue-700 rounded hover:bg-blue-100 font-medium"
                >
                  + All Recommended
                </button>
              )}
            </div>
          )}
        </div>
      </div>

      {/* Main Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Available Initiatives (Left) */}
        <div className="lg:col-span-2 space-y-4">
          {/* Collapsible Filters */}
          <div className="bg-white rounded-lg shadow-sm p-4">
            <button
              onClick={() => setShowFilters(!showFilters)}
              className="w-full flex items-center justify-between text-sm font-medium text-slate-900"
            >
              <div className="flex items-center gap-2">
                <Filter className="w-4 h-4" />
                <span>Filters</span>
                {hasFilters && (
                  <span className="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded">Active</span>
                )}
              </div>
              {showFilters ? <ChevronUp className="w-4 h-4" /> : <ChevronDown className="w-4 h-4" />}
            </button>

            {showFilters && (
              <div className="mt-3 space-y-3 pt-3 border-t border-slate-200">
                {/* Search */}
                <input
                  type="text"
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  placeholder="Search initiatives..."
                  className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                />

                {/* Category & Priority Filters */}
                <div className="grid grid-cols-2 gap-3">
                  <select
                    value={filterCategory}
                    onChange={(e) => setFilterCategory(e.target.value as InitiativeCategory | 'all')}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  >
                    <option value="all">All Categories</option>
                    {Object.entries(CATEGORY_INFO).map(([key, info]) => (
                      <option key={key} value={key}>
                        {info.emoji} {info.label}
                      </option>
                    ))}
                  </select>

                  <select
                    value={filterPriority}
                    onChange={(e) => setFilterPriority(e.target.value as InitiativePriority | 'all')}
                    className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  >
                    <option value="all">All Priorities</option>
                    {Object.entries(PRIORITY_INFO).map(([key, info]) => (
                      <option key={key} value={key}>
                        {info.label}
                      </option>
                    ))}
                  </select>
                </div>

                {hasFilters && (
                  <button
                    onClick={() => {
                      setSearchQuery('')
                      setFilterCategory('all')
                      setFilterPriority('all')
                    }}
                    className="text-xs text-blue-600 hover:text-blue-700 font-medium"
                  >
                    Clear all filters
                  </button>
                )}
              </div>
            )}
          </div>

          {/* Available Initiatives List */}
          <div className="bg-white rounded-lg shadow-sm p-4">
            <div className="mb-3 flex items-center justify-between">
              <h4 className="font-semibold text-slate-900 text-sm">Available Initiatives ({filteredInitiatives.length})</h4>
            </div>

            {filteredInitiatives.length === 0 && allAvailableInitiatives.length === 0 ? (
              <div className="p-8 bg-slate-50 rounded-lg text-center">
                <p className="text-sm text-slate-600">
                  No initiatives yet. Go back to Steps 2 & 3 to add ideas and recommendations.
                </p>
              </div>
            ) : filteredInitiatives.length === 0 ? (
              <div className="p-8 bg-slate-50 rounded-lg text-center">
                <p className="text-sm text-slate-600">
                  No initiatives match your filters.
                </p>
              </div>
            ) : (
              <div className="space-y-2 max-h-[600px] overflow-y-auto">
                {filteredInitiatives.map((initiative) => {
                  const isSelected = twelveMonthInitiatives.some(item => item.id === initiative.id)
                  const isExpanded = expandedId === initiative.id
                  const categoryInfo = initiative.category ? CATEGORY_INFO[initiative.category] : CATEGORY_INFO.other
                  const priorityInfo = initiative.priority ? PRIORITY_INFO[initiative.priority] : null
                  const effortInfo = initiative.estimatedEffort ? EFFORT_INFO[initiative.estimatedEffort] : null

                  return (
                    <div
                      key={initiative.id}
                      className={`rounded-lg transition-all ${
                        isSelected
                          ? 'bg-blue-50 shadow-sm'
                          : 'bg-white hover:shadow-sm'
                      }`}
                    >
                      {/* Main Card - Simplified */}
                      <button
                        onClick={() => handleToggleInitiative(initiative)}
                        className="w-full text-left p-3"
                      >
                        <div className="flex items-start gap-3">
                          {/* Checkbox */}
                          <div className={`w-5 h-5 rounded border-2 flex items-center justify-center flex-shrink-0 mt-0.5 ${
                            isSelected
                              ? 'bg-blue-500 border-blue-500'
                              : 'border-slate-300'
                          }`}>
                            {isSelected && <Check className="w-3 h-3 text-white" />}
                          </div>

                          <div className="flex-1 min-w-0">
                            {/* Title */}
                            <p className="text-sm font-medium text-slate-900 mb-1.5">
                              {initiative.title}
                            </p>

                            {/* Simplified Metadata - Only Priority + Category Emoji */}
                            <div className="flex items-center gap-2">
                              {priorityInfo && (
                                <span className={`text-xs px-2 py-0.5 rounded font-medium ${priorityInfo.color}`}>
                                  {priorityInfo.label}
                                </span>
                              )}
                              <span className="text-base" title={categoryInfo.label}>
                                {categoryInfo.emoji}
                              </span>
                            </div>
                          </div>
                        </div>
                      </button>

                      {/* Expand Details Button */}
                      {(initiative.description || initiative.notes || initiative.estimatedEffort) && (
                        <div className="px-3 pb-2">
                          <button
                            onClick={(e) => {
                              e.stopPropagation()
                              setExpandedId(isExpanded ? null : initiative.id)
                            }}
                            className="text-xs text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1"
                          >
                            {isExpanded ? (
                              <>
                                <ChevronUp className="w-3 h-3" /> Less
                              </>
                            ) : (
                              <>
                                <ChevronDown className="w-3 h-3" /> More details
                              </>
                            )}
                          </button>
                        </div>
                      )}

                      {/* Expanded Details */}
                      {isExpanded && (
                        <div className="px-3 pb-3 pt-0 border-t border-slate-200 mt-1 bg-slate-50">
                          <div className="pt-2 space-y-2 text-xs">
                            {effortInfo && (
                              <div className="flex items-center gap-2">
                                <span className="text-slate-600 font-medium">Effort:</span>
                                <span className="text-slate-900">{effortInfo.icon} {effortInfo.label}</span>
                              </div>
                            )}
                            {initiative.description && (
                              <div>
                                <p className="text-slate-600 font-medium mb-1">Description:</p>
                                <p className="text-slate-700">{initiative.description}</p>
                              </div>
                            )}
                            {initiative.notes && (
                              <div>
                                <p className="text-slate-600 font-medium mb-1">Notes:</p>
                                <p className="text-slate-700">{initiative.notes}</p>
                              </div>
                            )}
                          </div>
                        </div>
                      )}
                    </div>
                  )
                })}
              </div>
            )}
          </div>
        </div>

        {/* Selected Initiatives & Quick Stats (Right) */}
        <div className="space-y-4">
          {/* Selected Initiatives - Compact */}
          <div className="bg-white rounded-lg shadow-sm p-4">
            <div className="mb-3 flex items-center justify-between">
              <h4 className="font-semibold text-slate-900 text-sm">
                Your 12-Month Plan ({selectedCount})
              </h4>
              {selectedCount > 0 && (
                <button
                  onClick={handleClearAll}
                  className="text-xs text-red-600 hover:text-red-700 font-medium"
                >
                  Clear
                </button>
              )}
            </div>

            {selectedCount === 0 ? (
              <div className="p-6 bg-slate-50 rounded-lg text-center">
                <p className="text-xs text-slate-600">
                  Select initiatives from the left
                </p>
              </div>
            ) : (
              <div className="space-y-1.5 max-h-[500px] overflow-y-auto">
                {twelveMonthInitiatives.map((initiative, index) => {
                  const categoryInfo = initiative.category ? CATEGORY_INFO[initiative.category] : CATEGORY_INFO.other

                  return (
                    <div
                      key={initiative.id}
                      draggable
                      onDragStart={() => handleDragStart(index)}
                      onDragOver={(e) => handleDragOver(e, index)}
                      onDragEnd={handleDragEnd}
                      className={`p-2 bg-blue-50 rounded transition-all cursor-move hover:bg-blue-100 ${
                        draggedIndex === index ? 'opacity-50' : ''
                      }`}
                    >
                      <div className="flex items-start gap-2">
                        <GripVertical className="w-3 h-3 text-slate-400 flex-shrink-0 mt-1" />

                        <div className="flex-1 min-w-0">
                          <div className="flex items-center gap-1.5 mb-0.5">
                            <span className="text-xs font-bold text-blue-700 bg-blue-200 px-1.5 py-0.5 rounded flex-shrink-0">
                              {index + 1}
                            </span>
                            <span className="text-xs" title={categoryInfo.label}>
                              {categoryInfo.emoji}
                            </span>
                          </div>
                          <p className="text-xs font-medium text-slate-900 leading-tight">
                            {initiative.title}
                          </p>
                        </div>

                        <button
                          onClick={() => handleRemoveInitiative(initiative.id)}
                          className="text-slate-400 hover:text-red-600 transition-colors flex-shrink-0"
                          title="Remove"
                        >
                          <X className="w-3 h-3" />
                        </button>
                      </div>
                    </div>
                  )
                })}
              </div>
            )}
          </div>

          {/* Quick Stats - Simplified Balance */}
          {selectedCount > 0 && (
            <div className="bg-white rounded-lg shadow-sm p-4">
              <button
                onClick={() => setShowBalanceDetails(!showBalanceDetails)}
                className="w-full flex items-center justify-between text-sm font-semibold text-slate-900 mb-2"
              >
                <span>Quick Stats</span>
                {showBalanceDetails ? <ChevronUp className="w-4 h-4" /> : <ChevronDown className="w-4 h-4" />}
              </button>

              {/* Compact Summary */}
              <div className="flex items-center gap-3 text-xs text-slate-700">
                <div className="flex items-center gap-1">
                  <span className="font-medium">{balanceStats.categoryDiversity}</span>
                  <span>categories</span>
                </div>
                <span className="text-slate-300">•</span>
                <div className="flex items-center gap-1">
                  <Zap className="w-3 h-3 text-amber-500" />
                  <span className="font-medium">{balanceStats.quickWins}</span>
                  <span>quick wins</span>
                </div>
              </div>

              {/* Detailed Breakdown - Collapsible */}
              {showBalanceDetails && (
                <div className="mt-3 pt-3 border-t border-slate-200 space-y-3">
                  {/* Category Balance */}
                  <div>
                    <p className="text-xs font-medium text-slate-700 mb-1.5">By Category:</p>
                    <div className="space-y-1">
                      {Object.entries(balanceStats.categoryCount).map(([category, count]) => {
                        const info = CATEGORY_INFO[category as InitiativeCategory]
                        return (
                          <div key={category} className="flex items-center justify-between text-xs">
                            <span className="text-slate-600">{info.emoji} {info.label}</span>
                            <span className="font-medium text-slate-900">{count}</span>
                          </div>
                        )
                      })}
                    </div>
                  </div>

                  {/* Effort Balance */}
                  <div>
                    <p className="text-xs font-medium text-slate-700 mb-1.5">By Effort:</p>
                    <div className="space-y-1">
                      {Object.entries(balanceStats.effortCount).map(([effort, count]) => {
                        const info = EFFORT_INFO[effort as InitiativeEffort]
                        return (
                          <div key={effort} className="flex items-center justify-between text-xs">
                            <span className="text-slate-600">{info.icon} {info.label}</span>
                            <span className="font-medium text-slate-900">{count}</span>
                          </div>
                        )
                      })}
                    </div>
                  </div>

                  {/* Balance Assessment */}
                  <div className="pt-2 border-t border-slate-200">
                    {balanceStats.categoryDiversity >= 3 ? (
                      <p className="text-xs text-emerald-600">
                        ✓ Well balanced across {balanceStats.categoryDiversity} areas
                      </p>
                    ) : (
                      <p className="text-xs text-amber-600">
                        Consider adding diversity across more categories
                      </p>
                    )}
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      </div>

      {/* Bottom Status Messages - Simplified */}
      {isOverLimit && (
        <div className="bg-red-50 border border-red-200 rounded-lg p-3">
          <p className="text-sm text-red-800">
            You have {selectedCount} initiatives. Remove {selectedCount - 10} to stay within the recommended 5-10 range.
          </p>
        </div>
      )}

      {selectedCount > 0 && selectedCount < 5 && (
        <div className="bg-amber-50 border border-amber-200 rounded-lg p-3">
          <p className="text-sm text-amber-800">
            Add at least {5 - selectedCount} more initiatives to reach the recommended minimum.
          </p>
        </div>
      )}

      {isInRange && (
        <div className="bg-emerald-50 border border-emerald-200 rounded-lg p-3">
          <p className="text-sm text-emerald-800">
            ✓ Perfect! You have {selectedCount} initiatives selected - a well-balanced plan for the next 12 months.
          </p>
        </div>
      )}
    </div>
  )
}
