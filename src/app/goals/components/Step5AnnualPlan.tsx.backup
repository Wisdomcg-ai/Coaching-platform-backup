'use client'

import { StrategicInitiative, FinancialData, KPIData } from '../types'
import { ChevronDown, ChevronUp, Target as TargetIcon, Lightbulb, Calendar } from 'lucide-react'
import { useState, useEffect } from 'react'

interface Step5Props {
  twelveMonthInitiatives: StrategicInitiative[]
  annualPlanByQuarter: Record<string, StrategicInitiative[]>
  setAnnualPlanByQuarter: (plan: Record<string, StrategicInitiative[]>) => void
  financialData: FinancialData | null
  kpis: KPIData[]
}

export default function Step5AnnualPlan({
  twelveMonthInitiatives,
  annualPlanByQuarter,
  setAnnualPlanByQuarter,
  financialData,
  kpis
}: Step5Props) {
  // Quarterly target values (free-form inputs)
  const [quarterlyTargets, setQuarterlyTargets] = useState<Record<string, { q1: string; q2: string; q3: string; q4: string }>>({})
  const [showTargetsSection, setShowTargetsSection] = useState(true)

  // Load quarterly targets from localStorage on mount
  useEffect(() => {
    const saved = localStorage.getItem('quarterlyTargets')
    if (saved) {
      setQuarterlyTargets(JSON.parse(saved))
    }
  }, [])

  // Save quarterly targets to localStorage whenever they change
  useEffect(() => {
    localStorage.setItem('quarterlyTargets', JSON.stringify(quarterlyTargets))
  }, [quarterlyTargets])

  // Update quarterly target value
  const updateQuarterlyTarget = (metricKey: string, quarter: 'q1' | 'q2' | 'q3' | 'q4', value: string) => {
    setQuarterlyTargets(prev => ({
      ...prev,
      [metricKey]: {
        q1: quarter === 'q1' ? value : (prev[metricKey]?.q1 || ''),
        q2: quarter === 'q2' ? value : (prev[metricKey]?.q2 || ''),
        q3: quarter === 'q3' ? value : (prev[metricKey]?.q3 || ''),
        q4: quarter === 'q4' ? value : (prev[metricKey]?.q4 || '')
      }
    }))
  }

  // Format currency for display
  const formatCurrency = (value: number) => {
    if (value >= 1000000) {
      return `$${(value / 1000000).toFixed(1)}M`
    } else if (value >= 1000) {
      return `$${(value / 1000).toFixed(0)}k`
    }
    return `$${value.toLocaleString()}`
  }

  return (
    <div className="space-y-6">
      {/* Section 1: Year 1 Targets - Quarterly Breakdown */}
      {financialData && (
        <div className="bg-white rounded-lg shadow-sm border border-slate-200">
          <button
            onClick={() => setShowTargetsSection(!showTargetsSection)}
            className="w-full flex items-center justify-between p-6 hover:bg-slate-50 transition-colors"
          >
            <div className="flex items-center gap-3">
              <TargetIcon className="w-5 h-5 text-blue-600" />
              <div className="text-left">
                <h3 className="text-lg font-semibold text-slate-900">Year 1 Targets - Quarterly Breakdown</h3>
                <p className="text-sm text-slate-600">Set your quarterly targets for each metric</p>
              </div>
            </div>
            {showTargetsSection ? (
              <ChevronUp className="w-5 h-5 text-slate-600" />
            ) : (
              <ChevronDown className="w-5 h-5 text-slate-600" />
            )}
          </button>

          {showTargetsSection && (
            <div className="p-6 pt-0 space-y-6">
              {/* Financial Targets Table */}
              <div>
                <h4 className="text-sm font-semibold text-gray-900 mb-3">Financial Targets & Core Metrics</h4>
                <div className="overflow-x-auto">
                  <table className="w-full border-collapse">
                    <thead>
                      <tr className="border-b-2 border-gray-300">
                        <th className="p-3 text-left text-sm font-bold text-gray-700 sticky left-0 z-10 bg-gray-50">Metric</th>
                        <th className="p-3 text-center text-sm font-bold text-gray-700 w-[150px] bg-gray-50">Year 1</th>
                        <th className="p-3 text-center text-sm font-bold text-gray-700 w-[150px] bg-gray-50">Q1</th>
                        <th className="p-3 text-center text-sm font-bold text-gray-700 w-[150px] bg-gray-50">Q2</th>
                        <th className="p-3 text-center text-sm font-bold text-gray-700 w-[150px] bg-gray-50">Q3</th>
                        <th className="p-3 text-center text-sm font-bold text-gray-700 w-[150px] bg-gray-50">Q4</th>
                      </tr>
                    </thead>
                    <tbody>
                      {/* Revenue ($) */}
                      {financialData.revenue.year1 > 0 && (
                        <tr className="border-b border-gray-200 hover:bg-blue-50 transition-colors bg-white">
                          <td className="p-3 sticky left-0 z-10 bg-inherit">
                            <span className="font-semibold text-gray-900 text-sm">Revenue ($)</span>
                          </td>
                          <td className="p-2 text-center">
                            <div className="text-sm font-medium text-gray-700">{formatCurrency(financialData.revenue.year1)}</div>
                          </td>
                          <td className="p-2 text-center">
                            <input
                              type="text"
                              value={quarterlyTargets['revenue']?.q1 || ''}
                              onChange={(e) => updateQuarterlyTarget('revenue', 'q1', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-2 border border-gray-300 rounded-md text-sm text-center font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent hover:border-blue-300 transition-colors"
                            />
                          </td>
                          <td className="p-2 text-center">
                            <input
                              type="text"
                              value={quarterlyTargets['revenue']?.q2 || ''}
                              onChange={(e) => updateQuarterlyTarget('revenue', 'q2', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-2 border border-gray-300 rounded-md text-sm text-center font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent hover:border-blue-300 transition-colors"
                            />
                          </td>
                          <td className="p-2 text-center">
                            <input
                              type="text"
                              value={quarterlyTargets['revenue']?.q3 || ''}
                              onChange={(e) => updateQuarterlyTarget('revenue', 'q3', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-2 border border-gray-300 rounded-md text-sm text-center font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent hover:border-blue-300 transition-colors"
                            />
                          </td>
                          <td className="p-2 text-center">
                            <input
                              type="text"
                              value={quarterlyTargets['revenue']?.q4 || ''}
                              onChange={(e) => updateQuarterlyTarget('revenue', 'q4', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-2 border border-gray-300 rounded-md text-sm text-center font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent hover:border-blue-300 transition-colors"
                            />
                          </td>
                        </tr>
                      )}

                      {/* Gross Profit */}
                      {financialData.grossProfit.year1 > 0 && (
                        <tr>
                          <td className="px-4 py-3 text-sm font-medium text-slate-900 border-r border-slate-200">Gross Profit</td>
                          <td className="px-4 py-3 text-sm text-slate-700 font-medium border-r border-slate-200">{formatCurrency(financialData.grossProfit.year1)}</td>
                          <td className="px-4 py-2 border-r border-slate-200">
                            <input
                              type="text"
                              value={quarterlyTargets['grossProfit']?.q1 || ''}
                              onChange={(e) => updateQuarterlyTarget('grossProfit', 'q1', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                          <td className="px-4 py-2 border-r border-slate-200">
                            <input
                              type="text"
                              value={quarterlyTargets['grossProfit']?.q2 || ''}
                              onChange={(e) => updateQuarterlyTarget('grossProfit', 'q2', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                          <td className="px-4 py-2 border-r border-slate-200">
                            <input
                              type="text"
                              value={quarterlyTargets['grossProfit']?.q3 || ''}
                              onChange={(e) => updateQuarterlyTarget('grossProfit', 'q3', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                          <td className="px-4 py-2">
                            <input
                              type="text"
                              value={quarterlyTargets['grossProfit']?.q4 || ''}
                              onChange={(e) => updateQuarterlyTarget('grossProfit', 'q4', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                        </tr>
                      )}

                      {/* Net Profit */}
                      {financialData.netProfit.year1 > 0 && (
                        <tr>
                          <td className="px-4 py-3 text-sm font-medium text-slate-900 border-r border-slate-200">Net Profit</td>
                          <td className="px-4 py-3 text-sm text-slate-700 font-medium border-r border-slate-200">{formatCurrency(financialData.netProfit.year1)}</td>
                          <td className="px-4 py-2 border-r border-slate-200">
                            <input
                              type="text"
                              value={quarterlyTargets['netProfit']?.q1 || ''}
                              onChange={(e) => updateQuarterlyTarget('netProfit', 'q1', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                          <td className="px-4 py-2 border-r border-slate-200">
                            <input
                              type="text"
                              value={quarterlyTargets['netProfit']?.q2 || ''}
                              onChange={(e) => updateQuarterlyTarget('netProfit', 'q2', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                          <td className="px-4 py-2 border-r border-slate-200">
                            <input
                              type="text"
                              value={quarterlyTargets['netProfit']?.q3 || ''}
                              onChange={(e) => updateQuarterlyTarget('netProfit', 'q3', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                          <td className="px-4 py-2">
                            <input
                              type="text"
                              value={quarterlyTargets['netProfit']?.q4 || ''}
                              onChange={(e) => updateQuarterlyTarget('netProfit', 'q4', e.target.value)}
                              placeholder="Enter target"
                              className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                            />
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>

              {/* KPIs Table - Show ALL KPIs */}
              {kpis && kpis.length > 0 && (
                <div>
                  <h4 className="text-sm font-semibold text-slate-900 mb-3">Key Performance Indicators</h4>
                  <div className="overflow-x-auto">
                    <table className="w-full border border-slate-200">
                      <thead className="bg-slate-50">
                        <tr>
                          <th className="px-4 py-3 text-left text-sm font-semibold text-slate-900 border-b border-r border-slate-200">KPI</th>
                          <th className="px-4 py-3 text-left text-sm font-semibold text-slate-900 border-b border-r border-slate-200">Year 1</th>
                          <th className="px-4 py-3 text-center text-sm font-semibold text-slate-900 border-b border-r border-slate-200">Q1</th>
                          <th className="px-4 py-3 text-center text-sm font-semibold text-slate-900 border-b border-r border-slate-200">Q2</th>
                          <th className="px-4 py-3 text-center text-sm font-semibold text-slate-900 border-b border-r border-slate-200">Q3</th>
                          <th className="px-4 py-3 text-center text-sm font-semibold text-slate-900 border-b border-slate-200">Q4</th>
                        </tr>
                      </thead>
                      <tbody className="bg-white divide-y divide-slate-200">
                        {kpis.map((kpi) => (
                          <tr key={kpi.id}>
                            <td className="px-4 py-3 text-sm font-medium text-slate-900 border-r border-slate-200">{kpi.name}</td>
                            <td className="px-4 py-3 text-sm text-slate-700 font-medium border-r border-slate-200">
                              {kpi.year1Target} {kpi.unit}
                            </td>
                            <td className="px-4 py-2 border-r border-slate-200">
                              <input
                                type="text"
                                value={quarterlyTargets[kpi.id]?.q1 || ''}
                                onChange={(e) => updateQuarterlyTarget(kpi.id, 'q1', e.target.value)}
                                placeholder="Target"
                                className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                              />
                            </td>
                            <td className="px-4 py-2 border-r border-slate-200">
                              <input
                                type="text"
                                value={quarterlyTargets[kpi.id]?.q2 || ''}
                                onChange={(e) => updateQuarterlyTarget(kpi.id, 'q2', e.target.value)}
                                placeholder="Target"
                                className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                              />
                            </td>
                            <td className="px-4 py-2 border-r border-slate-200">
                              <input
                                type="text"
                                value={quarterlyTargets[kpi.id]?.q3 || ''}
                                onChange={(e) => updateQuarterlyTarget(kpi.id, 'q3', e.target.value)}
                                placeholder="Target"
                                className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                              />
                            </td>
                            <td className="px-4 py-2">
                              <input
                                type="text"
                                value={quarterlyTargets[kpi.id]?.q4 || ''}
                                onChange={(e) => updateQuarterlyTarget(kpi.id, 'q4', e.target.value)}
                                placeholder="Target"
                                className="w-full px-2 py-1.5 text-sm border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-center"
                              />
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {/* Facilitation Question */}
              <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <p className="text-sm text-slate-800 font-medium">
                  <Lightbulb className="w-4 h-4 inline mr-2 text-blue-600" />
                  <strong>Key Question:</strong> "What are the key initiatives or projects you must implement to help you meet or exceed these targets?"
                </p>
              </div>
            </div>
          )}
        </div>
      )}

      {/* Section 2: Placeholder for Initiative Kanban */}
      <div className="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <div className="flex items-center gap-3 mb-4">
          <Calendar className="w-5 h-5 text-blue-600" />
          <h3 className="text-lg font-semibold text-slate-900">Distribute Initiatives Across Quarters</h3>
        </div>
        <p className="text-sm text-slate-600">
          Initiative kanban board will be added here once we verify the quarterly targets section works.
        </p>
      </div>
    </div>
  )
}
