'use client'

import { StrategicInitiative, InitiativeCategory, InitiativePriority, InitiativeEffort } from '../types'
import { Plus, Trash2, AlertCircle, Edit2, ChevronDown, ChevronUp, Search, Filter, GripVertical, X, Sparkles } from 'lucide-react'
import { useState, useMemo } from 'react'

interface Step2Props {
  strategicIdeas: StrategicInitiative[]
  setStrategicIdeas: (ideas: StrategicInitiative[]) => void
}

const generateId = () => `idea-${Date.now()}-${Math.random()}`

const CATEGORIES: { value: InitiativeCategory; label: string; emoji: string }[] = [
  { value: 'marketing', label: 'Marketing & Sales', emoji: '📢' },
  { value: 'operations', label: 'Operations', emoji: '⚙️' },
  { value: 'finance', label: 'Finance', emoji: '💰' },
  { value: 'people', label: 'People & Culture', emoji: '👥' },
  { value: 'systems', label: 'Systems & Tech', emoji: '💻' },
  { value: 'product', label: 'Product & Service', emoji: '🎯' },
  { value: 'customer_experience', label: 'Customer Experience', emoji: '⭐' },
  { value: 'other', label: 'Other', emoji: '📋' }
]

const PRIORITIES: { value: InitiativePriority; label: string; color: string }[] = [
  { value: 'high', label: 'High', color: 'bg-red-100 text-red-800 border-red-300' },
  { value: 'medium', label: 'Medium', color: 'bg-yellow-100 text-yellow-800 border-yellow-300' },
  { value: 'low', label: 'Low', color: 'bg-green-100 text-green-800 border-green-300' }
]

const EFFORTS: { value: InitiativeEffort; label: string; description: string }[] = [
  { value: 'small', label: 'Small (1-4 weeks)', description: 'Quick win or minor project' },
  { value: 'medium', label: 'Medium (1-3 months)', description: 'Moderate project requiring focused effort' },
  { value: 'large', label: 'Large (3+ months)', description: 'Major initiative or transformation' }
]

export default function Step2StrategicIdeas({
  strategicIdeas = [],
  setStrategicIdeas
}: Step2Props) {
  const [newIdea, setNewIdea] = useState('')
  const [newCategory, setNewCategory] = useState<InitiativeCategory>('other')
  const [newPriority, setNewPriority] = useState<InitiativePriority>('medium')
  const [newEffort, setNewEffort] = useState<InitiativeEffort>('medium')

  const [editingId, setEditingId] = useState<string | null>(null)
  const [expandedId, setExpandedId] = useState<string | null>(null)
  const [searchQuery, setSearchQuery] = useState('')
  const [filterCategory, setFilterCategory] = useState<InitiativeCategory | 'all'>('all')
  const [filterPriority, setFilterPriority] = useState<InitiativePriority | 'all'>('all')
  const [showFilters, setShowFilters] = useState(false)
  const [draggedIndex, setDraggedIndex] = useState<number | null>(null)
  const [validationError, setValidationError] = useState('')

  // Filtered and sorted ideas
  const filteredIdeas = useMemo(() => {
    let filtered = strategicIdeas || []

    // Search filter
    if (searchQuery.trim()) {
      const query = searchQuery.toLowerCase()
      filtered = filtered.filter(
        idea =>
          idea.title.toLowerCase().includes(query) ||
          idea.notes?.toLowerCase().includes(query)
      )
    }

    // Category filter
    if (filterCategory !== 'all') {
      filtered = filtered.filter(idea => idea.category === filterCategory)
    }

    // Priority filter
    if (filterPriority !== 'all') {
      filtered = filtered.filter(idea => idea.priority === filterPriority)
    }

    // Sort by order
    return filtered.sort((a, b) => (a.order || 0) - (b.order || 0))
  }, [strategicIdeas, searchQuery, filterCategory, filterPriority])

  const validateIdea = (title: string): boolean => {
    if (!title.trim()) {
      setValidationError('Title cannot be empty')
      return false
    }

    if (title.length > 200) {
      setValidationError('Title must be 200 characters or less')
      return false
    }

    // Check for duplicates (excluding the idea being edited)
    const isDuplicate = strategicIdeas.some(
      idea =>
        idea.id !== editingId &&
        idea.title.toLowerCase().trim() === title.toLowerCase().trim()
    )

    if (isDuplicate) {
      setValidationError('This idea already exists')
      return false
    }

    setValidationError('')
    return true
  }

  const handleAddIdea = () => {
    if (!validateIdea(newIdea)) return

    const idea: StrategicInitiative = {
      id: generateId(),
      title: newIdea.trim(),
      category: newCategory,
      priority: newPriority,
      estimatedEffort: newEffort,
      source: 'strategic_ideas',
      selected: false,
      order: strategicIdeas.length
    }
    setStrategicIdeas([...(strategicIdeas || []), idea])

    // Reset form
    setNewIdea('')
    setNewCategory('other')
    setNewPriority('medium')
    setNewEffort('medium')
    setValidationError('')
  }

  const handleUpdateIdea = (id: string, updates: Partial<StrategicInitiative>) => {
    if (updates.title && !validateIdea(updates.title)) return

    setStrategicIdeas(
      (strategicIdeas || []).map(idea =>
        idea.id === id ? { ...idea, ...updates } : idea
      )
    )
    setEditingId(null)
    setValidationError('')
  }

  const handleRemoveIdea = (id: string) => {
    setStrategicIdeas((strategicIdeas || []).filter(i => i.id !== id))
  }

  const handleBulkDelete = () => {
    if (confirm(`Delete all ${filteredIdeas.length} filtered ideas?`)) {
      const idsToDelete = new Set(filteredIdeas.map(i => i.id))
      setStrategicIdeas((strategicIdeas || []).filter(i => !idsToDelete.has(i.id)))
    }
  }

  const handleDragStart = (index: number) => {
    setDraggedIndex(index)
  }

  const handleDragOver = (e: React.DragEvent, index: number) => {
    e.preventDefault()

    if (draggedIndex === null || draggedIndex === index) return

    const reordered = [...filteredIdeas]
    const draggedItem = reordered[draggedIndex]
    reordered.splice(draggedIndex, 1)
    reordered.splice(index, 0, draggedItem)

    // Update order property
    const updated = reordered.map((idea, idx) => ({ ...idea, order: idx }))

    setStrategicIdeas(updated)
    setDraggedIndex(index)
  }

  const handleDragEnd = () => {
    setDraggedIndex(null)
  }

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      handleAddIdea()
    }
  }

  const getCategoryInfo = (category?: InitiativeCategory) => {
    return CATEGORIES.find(c => c.value === category) || CATEGORIES.find(c => c.value === 'other')!
  }

  const getPriorityInfo = (priority?: InitiativePriority) => {
    return PRIORITIES.find(p => p.value === priority) || PRIORITIES[1]
  }

  const getEffortInfo = (effort?: InitiativeEffort) => {
    return EFFORTS.find(e => e.value === effort) || EFFORTS[1]
  }

  const safeIdeas = strategicIdeas || []
  const hasFilters = searchQuery || filterCategory !== 'all' || filterPriority !== 'all'

  return (
    <div className="space-y-6">
      <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div className="mb-6">
          <h3 className="text-lg font-semibold text-gray-900 mb-2">Strategic Ideas</h3>
          <p className="text-sm text-gray-600">
            Capture all the initiatives, projects, and ideas you want to pursue in the next 12 months. Don't filter - capture everything here. We'll prioritize in the next step.
          </p>
        </div>

        {/* Add New Idea Form */}
        <div className="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
          <h4 className="text-sm font-semibold text-gray-700 mb-3">Add New Idea</h4>

          <div className="space-y-3">
            {/* Title */}
            <div>
              <label className="block text-xs font-medium text-gray-700 mb-1">
                Title *
              </label>
              <input
                type="text"
                value={newIdea}
                onChange={(e) => setNewIdea(e.target.value)}
                onKeyDown={handleKeyDown}
                placeholder="e.g., 'Launch new marketing campaign'"
                className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
              />
            </div>

            {/* Category, Priority, Effort */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label className="block text-xs font-medium text-gray-700 mb-1">
                  Category
                </label>
                <select
                  value={newCategory}
                  onChange={(e) => setNewCategory(e.target.value as InitiativeCategory)}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                >
                  {CATEGORIES.map(cat => (
                    <option key={cat.value} value={cat.value}>
                      {cat.emoji} {cat.label}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-xs font-medium text-gray-700 mb-1">
                  Priority
                </label>
                <select
                  value={newPriority}
                  onChange={(e) => setNewPriority(e.target.value as InitiativePriority)}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                >
                  {PRIORITIES.map(pri => (
                    <option key={pri.value} value={pri.value}>
                      {pri.label}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-xs font-medium text-gray-700 mb-1">
                  Effort
                </label>
                <select
                  value={newEffort}
                  onChange={(e) => setNewEffort(e.target.value as InitiativeEffort)}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                >
                  {EFFORTS.map(eff => (
                    <option key={eff.value} value={eff.value}>
                      {eff.label}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            {/* Validation Error */}
            {validationError && (
              <div className="flex items-center gap-2 text-red-600 text-sm">
                <AlertCircle className="w-4 h-4" />
                <span>{validationError}</span>
              </div>
            )}

            {/* Add Button */}
            <button
              onClick={handleAddIdea}
              disabled={!newIdea.trim()}
              className="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors flex items-center justify-center gap-2 font-medium"
            >
              <Plus className="w-4 h-4" />
              Add Strategic Idea
            </button>
          </div>
        </div>

        {/* Search and Filter Bar */}
        {safeIdeas.length > 0 && (
          <div className="mb-4 space-y-3">
            <div className="flex gap-2">
              {/* Search */}
              <div className="flex-1 relative">
                <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" />
                <input
                  type="text"
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  placeholder="Search ideas..."
                  className="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                />
                {searchQuery && (
                  <button
                    onClick={() => setSearchQuery('')}
                    className="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600"
                  >
                    <X className="w-4 h-4" />
                  </button>
                )}
              </div>

              {/* Filter Toggle */}
              <button
                onClick={() => setShowFilters(!showFilters)}
                className={`px-4 py-2 border rounded-lg font-medium text-sm transition-colors flex items-center gap-2 ${
                  hasFilters
                    ? 'bg-blue-50 border-blue-300 text-blue-700'
                    : 'bg-white border-gray-300 text-gray-700 hover:bg-gray-50'
                }`}
              >
                <Filter className="w-4 h-4" />
                Filters
                {hasFilters && <span className="bg-blue-600 text-white text-xs px-1.5 py-0.5 rounded-full">•</span>}
              </button>

              {/* Bulk Delete */}
              {filteredIdeas.length > 0 && hasFilters && (
                <button
                  onClick={handleBulkDelete}
                  className="px-4 py-2 border border-red-300 bg-red-50 text-red-700 rounded-lg hover:bg-red-100 font-medium text-sm transition-colors flex items-center gap-2"
                >
                  <Trash2 className="w-4 h-4" />
                  Delete Filtered ({filteredIdeas.length})
                </button>
              )}
            </div>

            {/* Filter Options */}
            {showFilters && (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                <div>
                  <label className="block text-xs font-medium text-gray-700 mb-1">
                    Category
                  </label>
                  <select
                    value={filterCategory}
                    onChange={(e) => setFilterCategory(e.target.value as InitiativeCategory | 'all')}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  >
                    <option value="all">All Categories</option>
                    {CATEGORIES.map(cat => (
                      <option key={cat.value} value={cat.value}>
                        {cat.emoji} {cat.label}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="block text-xs font-medium text-gray-700 mb-1">
                    Priority
                  </label>
                  <select
                    value={filterPriority}
                    onChange={(e) => setFilterPriority(e.target.value as InitiativePriority | 'all')}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                  >
                    <option value="all">All Priorities</option>
                    {PRIORITIES.map(pri => (
                      <option key={pri.value} value={pri.value}>
                        {pri.label}
                      </option>
                    ))}
                  </select>
                </div>

                {hasFilters && (
                  <div className="md:col-span-2">
                    <button
                      onClick={() => {
                        setSearchQuery('')
                        setFilterCategory('all')
                        setFilterPriority('all')
                      }}
                      className="text-sm text-blue-600 hover:text-blue-700 font-medium"
                    >
                      Clear all filters
                    </button>
                  </div>
                )}
              </div>
            )}
          </div>
        )}

        {/* Ideas List */}
        {filteredIdeas.length === 0 && safeIdeas.length === 0 ? (
          <div className="p-8 bg-gray-50 rounded-lg text-center border-2 border-dashed border-gray-300">
            <AlertCircle className="w-12 h-12 text-gray-400 mx-auto mb-3" />
            <p className="text-gray-600 font-medium">No ideas yet</p>
            <p className="text-sm text-gray-500 mt-1">
              Start by adding your first strategic idea above
            </p>
          </div>
        ) : filteredIdeas.length === 0 ? (
          <div className="p-8 bg-gray-50 rounded-lg text-center border-2 border-dashed border-gray-300">
            <Search className="w-12 h-12 text-gray-400 mx-auto mb-3" />
            <p className="text-gray-600 font-medium">No ideas match your filters</p>
            <p className="text-sm text-gray-500 mt-1">
              Try adjusting your search or filter criteria
            </p>
          </div>
        ) : (
          <div className="space-y-2">
            {filteredIdeas.map((idea, index) => {
              const isExpanded = expandedId === idea.id
              const isEditing = editingId === idea.id
              const categoryInfo = getCategoryInfo(idea.category)
              const priorityInfo = getPriorityInfo(idea.priority)
              const effortInfo = getEffortInfo(idea.estimatedEffort)

              return (
                <div
                  key={idea.id}
                  draggable
                  onDragStart={() => handleDragStart(index)}
                  onDragOver={(e) => handleDragOver(e, index)}
                  onDragEnd={handleDragEnd}
                  className={`border rounded-lg transition-all ${
                    draggedIndex === index
                      ? 'opacity-50 bg-gray-100'
                      : 'bg-blue-50 border-blue-200 hover:bg-blue-100'
                  }`}
                >
                  {/* Main Row */}
                  <div className="flex items-start gap-3 p-3">
                    {/* Drag Handle */}
                    <div className="cursor-move text-gray-400 hover:text-gray-600 pt-1">
                      <GripVertical className="w-4 h-4" />
                    </div>

                    {/* Number */}
                    <span className="text-sm font-bold text-blue-600 bg-blue-100 px-2.5 py-0.5 rounded mt-0.5 flex-shrink-0">
                      {index + 1}
                    </span>

                    {/* Content */}
                    <div className="flex-1 min-w-0">
                      {isEditing ? (
                        <div className="space-y-2">
                          <input
                            type="text"
                            defaultValue={idea.title}
                            onBlur={(e) => handleUpdateIdea(idea.id, { title: e.target.value })}
                            onKeyDown={(e) => {
                              if (e.key === 'Enter') {
                                handleUpdateIdea(idea.id, { title: e.currentTarget.value })
                              }
                            }}
                            autoFocus
                            className="w-full px-3 py-1.5 border border-blue-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm font-medium"
                          />
                        </div>
                      ) : (
                        <>
                          <p className="text-sm font-medium text-gray-900">{idea.title}</p>

                          {/* Badges */}
                          <div className="flex flex-wrap gap-2 mt-2">
                            <span className="inline-flex items-center gap-1 text-xs px-2 py-0.5 bg-white border border-gray-300 rounded">
                              {categoryInfo.emoji} {categoryInfo.label}
                            </span>
                            <span className={`inline-flex items-center text-xs px-2 py-0.5 border rounded ${priorityInfo.color}`}>
                              {priorityInfo.label} Priority
                            </span>
                            <span className="inline-flex items-center text-xs px-2 py-0.5 bg-purple-100 text-purple-800 border border-purple-300 rounded">
                              {effortInfo.label}
                            </span>
                          </div>
                        </>
                      )}
                    </div>

                    {/* Actions */}
                    <div className="flex items-center gap-1 flex-shrink-0">
                      <button
                        onClick={() => setExpandedId(isExpanded ? null : idea.id)}
                        className="p-1.5 text-gray-400 hover:text-blue-600 transition-colors"
                        title={isExpanded ? 'Collapse' : 'Expand'}
                      >
                        {isExpanded ? <ChevronUp className="w-4 h-4" /> : <ChevronDown className="w-4 h-4" />}
                      </button>
                      <button
                        onClick={() => setEditingId(isEditing ? null : idea.id)}
                        className="p-1.5 text-gray-400 hover:text-blue-600 transition-colors"
                        title="Edit"
                      >
                        <Edit2 className="w-4 h-4" />
                      </button>
                      <button
                        onClick={() => handleRemoveIdea(idea.id)}
                        className="p-1.5 text-gray-400 hover:text-red-600 transition-colors"
                        title="Delete"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    </div>
                  </div>

                  {/* Expanded Details */}
                  {isExpanded && (
                    <div className="px-3 pb-3 pt-0 border-t border-blue-200 mt-2">
                      <div className="space-y-3 pt-3">
                        {/* Notes */}
                        <div>
                          <label className="block text-xs font-semibold text-gray-700 mb-1">
                            Notes
                          </label>
                          <textarea
                            defaultValue={idea.notes || ''}
                            onBlur={(e) => handleUpdateIdea(idea.id, { notes: e.target.value })}
                            placeholder="Additional context, rationale, or dependencies..."
                            rows={3}
                            className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm resize-none"
                          />
                        </div>

                        {/* Edit Metadata */}
                        <div className="grid grid-cols-3 gap-2">
                          <div>
                            <label className="block text-xs font-semibold text-gray-700 mb-1">
                              Category
                            </label>
                            <select
                              value={idea.category || 'other'}
                              onChange={(e) => handleUpdateIdea(idea.id, { category: e.target.value as InitiativeCategory })}
                              className="w-full px-2 py-1.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs"
                            >
                              {CATEGORIES.map(cat => (
                                <option key={cat.value} value={cat.value}>
                                  {cat.emoji} {cat.label}
                                </option>
                              ))}
                            </select>
                          </div>

                          <div>
                            <label className="block text-xs font-semibold text-gray-700 mb-1">
                              Priority
                            </label>
                            <select
                              value={idea.priority || 'medium'}
                              onChange={(e) => handleUpdateIdea(idea.id, { priority: e.target.value as InitiativePriority })}
                              className="w-full px-2 py-1.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs"
                            >
                              {PRIORITIES.map(pri => (
                                <option key={pri.value} value={pri.value}>
                                  {pri.label}
                                </option>
                              ))}
                            </select>
                          </div>

                          <div>
                            <label className="block text-xs font-semibold text-gray-700 mb-1">
                              Effort
                            </label>
                            <select
                              value={idea.estimatedEffort || 'medium'}
                              onChange={(e) => handleUpdateIdea(idea.id, { estimatedEffort: e.target.value as InitiativeEffort })}
                              className="w-full px-2 py-1.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs"
                            >
                              {EFFORTS.map(eff => (
                                <option key={eff.value} value={eff.value}>
                                  {eff.label}
                                </option>
                              ))}
                            </select>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        )}

        {/* Summary */}
        {safeIdeas.length > 0 && (
          <div className="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
            <div className="flex items-center justify-between">
              <p className="text-sm text-blue-900">
                <strong>{safeIdeas.length}</strong> idea{safeIdeas.length !== 1 ? 's' : ''} captured
                {hasFilters && filteredIdeas.length !== safeIdeas.length && (
                  <span className="text-blue-700"> ({filteredIdeas.length} shown)</span>
                )}
              </p>
              {safeIdeas.length >= 5 && (
                <div className="flex items-center gap-2 text-green-600">
                  <Sparkles className="w-4 h-4" />
                  <span className="text-sm font-medium">Ready for next step!</span>
                </div>
              )}
            </div>

            {/* Category Breakdown */}
            {safeIdeas.length > 0 && (
              <div className="mt-3 pt-3 border-t border-blue-200">
                <p className="text-xs font-semibold text-blue-900 mb-2">Breakdown by Category:</p>
                <div className="flex flex-wrap gap-2">
                  {CATEGORIES.map(cat => {
                    const count = safeIdeas.filter(i => i.category === cat.value).length
                    if (count === 0) return null
                    return (
                      <span key={cat.value} className="text-xs px-2 py-1 bg-white border border-blue-200 rounded">
                        {cat.emoji} {cat.label}: <strong>{count}</strong>
                      </span>
                    )
                  })}
                </div>
              </div>
            )}
          </div>
        )}
      </div>

      {/* Info Box */}
      <div className="bg-amber-50 border border-amber-200 rounded-lg p-4">
        <p className="text-sm text-amber-800">
          <strong>Pro Tip:</strong> Think big and capture everything. Include quick wins, strategic initiatives, team improvements, and system upgrades. We'll filter to 5-10 in the next step. Use categories and priorities to organize your thinking.
        </p>
      </div>
    </div>
  )
}
